{
  "name": "the-moonpanel",
  "version": "1.0.0",
  "description": "The Moonpanel",
  "homepage": "https://github.com/NotMyWing/moonpanel#readme",
  "bugs": {
    "url": "https://github.com/NotMyWing/moonpanel/issues"
  },
  "license": "Apache-2.0",
